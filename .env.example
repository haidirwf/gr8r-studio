# ==============================================================================
# Gr8r Studio - Variabel Lingkungan Supabase
# ==============================================================================
# Salin file ini menjadi .env:
#   cp .env.example .env
#
# Dapatkan kredensial project dari:
#   https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================

# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public API Key (aman untuk frontend client Vite)
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
